{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user with a role",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "object", "description": "Firestore Timestamp" },
        "createdBy": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Stores user roles and approvals"
    }
  }
}
